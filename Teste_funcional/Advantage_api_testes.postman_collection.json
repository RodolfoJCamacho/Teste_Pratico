        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Produto deve possuir campos obrigatórios\", function(){\r",
              "\r",
              "let response = pm.response.json();\r",
              "\r",
              "response.forEach(produto => {\r",
              "\r",
              "pm.expect(produto).to.have.property(\"productId\");\r",
              "\r",
              "pm.expect(produto).to.have.property(\"productName\");\r",
              "\r",
              "});\r",
              "\r",
              "});"
